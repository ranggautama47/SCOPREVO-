# =============================================================
# SCOPREVO Backend — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# --- Database ---
# Supabase PostgreSQL connection string.
# For local dev: use the direct connection string from Supabase dashboard.
# For EdgeOne Cloud Functions: use the Supavisor (pooled) connection string
# in transaction mode. [UNVERIFIED — PENDING DAY 0]
DATABASE_URL=postgresql://postgres:<password>@<host>:<port>/<database>

# --- JWT ---
# A long, random secret string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_chars

# JWT expiry duration (e.g. "7d", "24h", "1h")
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# --- Opsional: Kalau pakai Gmail (aktifkan App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_16chars
